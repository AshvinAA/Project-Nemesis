 	    {
 	      memsize = TYPE_SIZE_UNIT (TREE_TYPE (init));
+	      if (!memsize)
+		/* The initializer's array type has no size (its domain
+		   was never set).  The size of the member cannot be
+		   determined from it.  */
+		return NULL_TREE;
 	      if (tree refsize = TYPE_SIZE_UNIT (argtype))
